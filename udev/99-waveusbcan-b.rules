#
# waveUSBCAN_b / Waveshare USB-CAN-B / CANalyst-II compatible adapter.
# The kernel module has a USB MODULE_DEVICE_TABLE and should autoload after depmod.
# This rule also triggers systemd to configure can0/can1 when the adapter is hotplugged.
SUBSYSTEM=="usb", ACTION=="add", ATTR{idVendor}=="04d8", ATTR{idProduct}=="0053", TAG+="uaccess", TAG+="systemd", ENV{ID_MODEL}="waveUSBCAN_b", ENV{SYSTEMD_WANTS}+="waveusbcan_b-auto.service"
